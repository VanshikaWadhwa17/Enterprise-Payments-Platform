# Copy this file to .env and fill in values for local development.
# Never commit the real .env file.

# Frontend -> backend
# NOTE: no separate GraphQL Gateway yet. Each MFE's Apollo Client talks
# directly to its own backend service (see apps/*/src/app/app.config.ts).
# These are READ AT CONTAINER START, not baked into the build -- see
# infra/env.template.js / infra/40-generate-env-js.sh / DEPLOYMENT.md.
# Only used by docker-compose (shell/payments/fraud/reconciliation
# services); `nx serve` uses each app's committed public/env.js instead.
GRAPHQL_PAYMENTS_URL=http://localhost:8080/graphql
GRAPHQL_FRAUD_URL=http://localhost:8082/graphql
GRAPHQL_RECONCILIATION_URL=http://localhost:8085/graphql
AUTH_API_URL=http://localhost:8086
REMOTE_PAYMENTS_URL=http://localhost:4201/remoteEntry.json
REMOTE_FRAUD_URL=http://localhost:4202/remoteEntry.json
REMOTE_RECONCILIATION_URL=http://localhost:4203/remoteEntry.json
REMOTE_REPORTS_URL=http://localhost:4204/remoteEntry.json
REMOTE_ADMIN_URL=http://localhost:4205/remoteEntry.json

# PostgreSQL (used by docker-compose; one instance, one database per service)
# NOTE: host port defaults to 5433, not 5432 -- many dev machines already run
# a local Postgres on 5432, and Docker's port publish loses that collision
# silently (connections to localhost:5432 go to the pre-existing service).
DB_HOST=localhost
DB_PORT=5433
DB_NAME=payments
DB_USER=payments
DB_PASSWORD=payments

# Per-service DB credentials (auth/account/fraud/audit/reconciliation each
# have their own database). Defaults below match the service name, same as
# payment-service's DB_USER/DB_PASSWORD above -- override any of these to
# use non-default credentials locally; a real deployment must not reuse
# these throwaway values.
AUTH_DB_USER=auth
AUTH_DB_PASSWORD=auth
ACCOUNT_DB_USER=accounts
ACCOUNT_DB_PASSWORD=accounts
FRAUD_DB_USER=fraud
FRAUD_DB_PASSWORD=fraud
AUDIT_DB_USER=audit
AUDIT_DB_PASSWORD=audit
RECONCILIATION_DB_USER=reconciliation
RECONCILIATION_DB_PASSWORD=reconciliation

# Redis (idempotency in payment-service, cache in account-service, rate
# limiting in payment-service)
REDIS_PORT=6379

# Kafka (KRaft mode, single broker; payment-service publishes PaymentCreated,
# fraud/notification/audit services consume it)
KAFKA_PORT=9092

# Backend service ports (also the container's own SERVER_PORT)
PAYMENT_SERVICE_PORT=8080
ACCOUNT_SERVICE_PORT=8081
FRAUD_SERVICE_PORT=8082
NOTIFICATION_SERVICE_PORT=8083
AUDIT_SERVICE_PORT=8084
RECONCILIATION_SERVICE_PORT=8085
AUTH_SERVICE_PORT=8086

CORS_ALLOWED_ORIGINS=http://localhost:4200,http://localhost:4201

# auth-service issues a JWT (HS256) on login/signup, delivered as an httpOnly
# cookie. payment-service, fraud-service, and reconciliation-service validate
# that same token as OAuth2 resource servers, so all four need this exact
# value. Set locally; generate with: openssl rand -base64 32
# Never commit the real value -- this line only ever holds the placeholder.
AUTH_JWT_SECRET=<set locally; generate with: openssl rand -base64 32>

# Set to true once the stack is served over https; httpOnly cookies with
# Secure=true are dropped by browsers over plain http.
COOKIE_SECURE=false

# Only used by the optional observability stack
# (docker-compose.observability.yml) -- Grafana admin login. Fine to leave
# at the default for local dev; change it if you're exposing port 3000
# beyond your own machine.
GRAFANA_ADMIN_PASSWORD=admin

# NOTE: this file only holds non-secret, public configuration.
# Angular ships everything in its config to the browser, so values like
# DATABASE_PASSWORD, JWT_SECRET, or API_PRIVATE_KEY must never live here or
# in any frontend environment file. Secrets belong on the backend services only.
# DB_PASSWORD above is fine here only because this is local-dev-only
# infrastructure with a throwaway default; a real environment must not
# commit its actual database credentials to a file like this one.
# AUTH_JWT_SECRET above is a placeholder for the same reason -- it must be
# overridden in your local, gitignored .env, never filled in here.
