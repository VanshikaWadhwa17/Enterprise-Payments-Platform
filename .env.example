# Copy this file to .env and fill in values for local development.
# Never commit the real .env file.

# Backend services
GRAPHQL_URL=http://localhost:4000/graphql
API_URL=http://localhost:8080
REDIS_URL=redis://localhost:6379
KAFKA_BROKERS=localhost:9092

# NOTE: this file only holds non-secret, public configuration.
# Angular ships everything in its config to the browser, so values like
# DATABASE_PASSWORD, JWT_SECRET, or API_PRIVATE_KEY must never live here or
# in any frontend environment file. Secrets belong on the backend services only.
