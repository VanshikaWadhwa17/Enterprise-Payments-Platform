# Copy this file to .env and fill in values for local development.
# Never commit the real .env file.

# Frontend -> backend
# NOTE: no separate GraphQL Gateway yet. Each MFE's Apollo Client talks
# directly to its own backend service (see apps/*/src/app/app.config.ts);
# a gateway aggregating all of them is a later addition.
GRAPHQL_URL=http://localhost:8080/graphql
API_URL=http://localhost:8080

# PostgreSQL (used by docker-compose; one instance, one database per service)
# NOTE: host port defaults to 5433, not 5432 -- many dev machines already run
# a local Postgres on 5432, and Docker's port publish loses that collision
# silently (connections to localhost:5432 go to the pre-existing service).
DB_HOST=localhost
DB_PORT=5433
DB_NAME=payments
DB_USER=payments
DB_PASSWORD=payments

# Redis (idempotency in payment-service, cache in account-service, rate
# limiting in payment-service)
REDIS_PORT=6379

# Kafka (KRaft mode, single broker; payment-service publishes PaymentCreated,
# fraud/notification/audit services consume it)
KAFKA_PORT=9092

# Backend service ports (also the container's own SERVER_PORT)
PAYMENT_SERVICE_PORT=8080
ACCOUNT_SERVICE_PORT=8081
FRAUD_SERVICE_PORT=8082
NOTIFICATION_SERVICE_PORT=8083
AUDIT_SERVICE_PORT=8084
RECONCILIATION_SERVICE_PORT=8085

CORS_ALLOWED_ORIGINS=http://localhost:4200,http://localhost:4201

# NOTE: this file only holds non-secret, public configuration.
# Angular ships everything in its config to the browser, so values like
# DATABASE_PASSWORD, JWT_SECRET, or API_PRIVATE_KEY must never live here or
# in any frontend environment file. Secrets belong on the backend services only.
# DB_PASSWORD above is fine here only because this is local-dev-only
# infrastructure with a throwaway default; a real environment must not
# commit its actual database credentials to a file like this one.
